FROM eclipse-temurin:21-jdk-jammy

LABEL author="YuraCloud" maintainer="dapa@dapaproject.my.id"

# Install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    wget \
    jq \
    unzip \
    zip \
    openssl \
    git \
    tar \
    sqlite3 \
    fontconfig \
    tzdata \
    iproute2 \
    cron \
    procps \
    tini \
    locales \
    iputils-ping \
    dnsutils \
    net-tools \
    netcat-openbsd \
    psmisc \
    libstdc++6 \
    zlib1g \
    && locale-gen en_US.UTF-8 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set timezone Asia/Jakarta
RUN ln -sf /usr/share/zoneinfo/Asia/Jakarta /etc/localtime && \
    echo "Asia/Jakarta" > /etc/timezone

# Setup user
RUN useradd -m -d /home/container -s /bin/bash container

# Copy scripts as root first
COPY entrypoint.sh /entrypoint.sh
COPY autorestart.sh /autorestart.sh

# Set permissions
RUN chmod +x /entrypoint.sh /autorestart.sh && \
    chown container:container /entrypoint.sh /autorestart.sh

USER container
ENV USER=container HOME=/home/container TZ=Asia/Jakarta LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8
WORKDIR /home/container

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/entrypoint.sh"]
