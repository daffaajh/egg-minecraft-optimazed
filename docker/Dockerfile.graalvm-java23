FROM ghcr.io/graalvm/jdk-community:23-ol9

LABEL author="YuraCloud" maintainer="dapa@dapaproject.my.id"

# Install dependencies
RUN microdnf install -y \
    ca-certificates \
    openssl \
    git \
    tar \
    sqlite \
    fontconfig \
    tzdata \
    iproute \
    libstdc++ \
    tini \
    cronie \
    procps-ng \
    && microdnf clean all

# Set timezone Asia/Jakarta
RUN ln -sf /usr/share/zoneinfo/Asia/Jakarta /etc/localtime && \
    echo "Asia/Jakarta" > /etc/timezone

# Setup user
RUN useradd -m -d /home/container -s /bin/bash container

# Copy scripts as root first
COPY entrypoint.sh /entrypoint.sh
COPY autorestart.sh /autorestart.sh

# Set permissions
RUN chmod +x /entrypoint.sh /autorestart.sh && \
    chown container:container /entrypoint.sh /autorestart.sh

USER container
ENV USER=container HOME=/home/container TZ=Asia/Jakarta
WORKDIR /home/container

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/entrypoint.sh"]
